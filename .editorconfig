root = true

[*.{kt,kts}]
indent_size = 4
insert_final_newline = true
max_line_length = 120
# @Composable functions are conventionally PascalCase (they read as UI elements, not
# actions) — this is idiomatic Compose style, not a naming-convention violation.
ktlint_function_naming_ignore_when_annotated_with = Composable
